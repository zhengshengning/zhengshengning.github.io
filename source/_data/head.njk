{# FOUC 防闪烁：在 CSS 加载前立即应用主题 #}
<script>
  (function(){
    var t = localStorage.getItem('blog-theme');
    if (t === 'dark') { document.documentElement.setAttribute('data-theme', 'dark'); }
    else { /* default is light, do nothing */ }
  })();
</script>

{# 自定义头部：导航栏内按钮和搜索框样式 #}
<style>
  /* 导航栏操作按钮统一样式 */
  .navbar-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid #e0e0e8;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    font-size: 15px;
    color: #1a1a2e;
    transition: all 0.25s ease;
  }

  .navbar-action-btn:hover {
    color: #0891b2;
    border-color: #0891b2;
    background: rgba(8, 145, 178, 0.06);
  }

  /* 搜索容器（导航栏内） */
  .floating-search-container {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* 搜索框 */
  .floating-search-input-wrapper {
    position: absolute;
    top: 50%;
    right: 44px;
    transform: translateY(-50%);
    display: none;
    animation: slideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .floating-search-input-wrapper.active {
    display: block;
  }

  .floating-search-input {
    width: 320px;
    height: 38px;
    padding: 0 38px 0 14px;
    border: 1px solid #e0e0e8;
    border-radius: 19px;
    font-size: 14px;
    outline: none;
    background: #fff;
    color: #1a1a2e;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .floating-search-input:focus {
    border-color: #059669;
    box-shadow: 0 6px 20px rgba(5, 150, 105, 0.2);
  }

  .floating-search-input::placeholder {
    color: #8888a0;
  }

  .floating-search-close {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: #1a1a2e;
    border: none;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    cursor: pointer;
    color: #fff;
    font-size: 12px;
    padding: 0;
    line-height: 22px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .floating-search-close:hover {
    transform: translateY(-50%) rotate(90deg);
  }

  /* 搜索结果弹出层 */
  .floating-search-results {
    position: fixed;
    top: 62px;
    right: 20px;
    width: 420px;
    max-height: 65vh;
    background: #fff;
    border: 1px solid #e0e0e8;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
    overflow-y: auto;
    display: none;
    z-index: 9998;
  }

  .floating-search-results.active {
    display: block;
    animation: fadeInScale 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .floating-search-results::-webkit-scrollbar {
    width: 6px;
  }

  .floating-search-results::-webkit-scrollbar-track {
    background: transparent;
  }

  .floating-search-results::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 3px;
  }

  .floating-search-result-item {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 14px 16px;
    border-bottom: 1px solid #f0f0f0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .floating-search-result-item:hover {
    background: #f5f5fa;
    padding-left: 20px;
  }

  .floating-search-result-item:last-child {
    border-bottom: none;
  }

  .floating-search-result-title {
    font-size: 15px;
    font-weight: 600;
    color: #1a1a2e;
    margin-bottom: 4px;
    line-height: 1.4;
  }

  .floating-search-result-title mark {
    background: #059669;
    color: #fff;
    padding: 1px 5px;
    border-radius: 3px;
    font-weight: 700;
  }

  .floating-search-result-content {
    font-size: 13px;
    color: #8888a0;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .floating-search-result-content mark {
    background: #d1fae5;
    color: #065f46;
    padding: 1px 3px;
    border-radius: 2px;
  }

  .floating-search-no-result {
    padding: 40px 20px;
    text-align: center;
    color: #8888a0;
    font-size: 15px;
  }

  .floating-search-no-result i {
    font-size: 40px;
    color: #ccc;
    display: block;
    margin-bottom: 12px;
  }

  /* 动画 */
  @keyframes slideIn {
    from { opacity: 0; transform: translateY(-50%) translateX(20px); }
    to { opacity: 1; transform: translateY(-50%) translateX(0); }
  }

  @keyframes fadeInScale {
    from { opacity: 0; transform: translateY(-8px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* 暗色模式 */
  html[data-theme="dark"] .navbar-action-btn {
    color: #e0e0e8;
    border-color: #2a2a3e;
  }

  html[data-theme="dark"] .navbar-action-btn:hover {
    color: #00ff88;
    border-color: #00ff88;
    box-shadow: 0 0 10px rgba(0, 255, 136, 0.15);
  }

  html[data-theme="dark"] .floating-search-input {
    background: #1a1a2e;
    color: #e0e0e8;
    border-color: #2a2a3e;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
  }

  html[data-theme="dark"] .floating-search-input:focus {
    border-color: #00ff88;
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.2);
  }

  html[data-theme="dark"] .floating-search-input::placeholder {
    color: #555;
  }

  html[data-theme="dark"] .floating-search-close {
    background: #2a2a3e;
  }

  html[data-theme="dark"] .floating-search-results {
    background: #12121a;
    border-color: #2a2a3e;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
  }

  html[data-theme="dark"] .floating-search-results::-webkit-scrollbar-track {
    background: #0a0a0f;
  }

  html[data-theme="dark"] .floating-search-results::-webkit-scrollbar-thumb {
    background: #2a2a3e;
  }

  html[data-theme="dark"] .floating-search-result-item {
    border-bottom-color: #2a2a3e;
  }

  html[data-theme="dark"] .floating-search-result-item:hover {
    background: #1a1a2e;
  }

  html[data-theme="dark"] .floating-search-result-title {
    color: #e0e0e8;
  }

  html[data-theme="dark"] .floating-search-result-title mark {
    background: #00ff88;
    color: #0a0a0f;
  }

  html[data-theme="dark"] .floating-search-result-content {
    color: #8888a0;
  }

  html[data-theme="dark"] .floating-search-result-content mark {
    background: rgba(0, 255, 136, 0.2);
    color: #00ff88;
  }

  html[data-theme="dark"] .floating-search-no-result {
    color: #555;
  }

  html[data-theme="dark"] .floating-search-no-result i {
    color: #2a2a3e;
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .floating-search-input {
      width: calc(100vw - 120px);
      height: 36px;
      font-size: 13px;
    }

    .floating-search-results {
      top: 62px;
      right: 10px;
      width: calc(100vw - 20px);
      max-height: 60vh;
    }

    .floating-search-result-item {
      padding: 12px;
    }

    .floating-search-result-title {
      font-size: 14px;
    }

    .floating-search-result-content {
      font-size: 12px;
    }
  }
</style>
