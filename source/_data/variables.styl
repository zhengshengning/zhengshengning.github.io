// ===================================
// Cyberpunk Developer Theme - Variable Overrides
// 覆盖 NexT base.styl 变量，在 _colors.styl 之前生效
// ===================================

// 系统字体栈优化（避免加载外部字体，提升首屏速度）
$font-family-chinese      = "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "WenQuanYi Micro Hei", sans-serif
$font-family-base         = -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, $font-family-chinese
$font-family-logo         = $font-family-base
$font-family-headings     = $font-family-base
$font-family-posts        = $font-family-base
$font-family-monospace    = "SFMono-Regular", Consolas, "Liberation Mono", Menlo, "Courier New", monospace, $font-family-chinese

// Light mode colors (default)
$body-bg-color                = #fafafa
$content-bg-color             = #ffffff
$card-bg-color                = #f0f0f5
$menu-item-bg-color           = #f0f0f5
$text-color                   = #1a1a2e
$link-color                   = #0891b2
$link-hover-color             = #059669
$blockquote-color             = #555
$border-color                 = #e0e0e8

// Dark mode colors (cyberpunk)
$body-bg-color-dark           = #0a0a0f
$content-bg-color-dark        = #12121a
$card-bg-color-dark           = #1a1a2e
$menu-item-bg-color-dark      = #1a1a2e
$text-color-dark              = #e0e0e8
$link-color-dark              = #00d4ff
$link-hover-color-dark        = #00ff88
$blockquote-color-dark        = #8888a0

// Brand/header
$brand-color                  = #0891b2
$brand-hover-color            = #059669
$brand-color-dark             = #00ff88
$brand-hover-color-dark       = #00d4ff

// Selection
$selection-bg                 = #059669
$selection-color              = #ffffff
$selection-bg-dark            = #00ff88
$selection-color-dark         = #0a0a0f

// Buttons
$btn-default-bg               = #1a1a2e
$btn-default-color            = #ffffff
$btn-default-border-color     = #1a1a2e
$btn-default-hover-bg         = #ffffff
$btn-default-hover-color      = #1a1a2e
$btn-default-hover-border-color = #1a1a2e

$btn-default-bg-dark               = transparent
$btn-default-color-dark            = #00ff88
$btn-default-border-color-dark     = #00ff88
$btn-default-hover-bg-dark         = #00ff88
$btn-default-hover-color-dark      = #0a0a0f
$btn-default-hover-border-color-dark = #00ff88

// Table
$table-row-odd-bg-color       = #f5f5fa
$table-row-odd-bg-color-dark  = #161622
$table-row-hover-bg-color     = #eeeef5
$table-row-hover-bg-color-dark = #1e1e30

// Sidebar
$site-author-name-color       = #ffffff
$site-description-color       = #8888a0

// Tag cloud
$tag-cloud-start              = #8888a0
$tag-cloud-end                = #1a1a2e
$tag-cloud-start-dark         = #555
$tag-cloud-end-dark           = #00d4ff

// Back to top
$b2t-bg-color                 = #1a1a2e
$b2t-color                    = #ffffff
