{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}
  {%- set page_title_suffix = ' | ' + title %}

  {%- if page.type === 'categories' and not page.title %}
    {{- __('title.category') + page_title_suffix }}
  {%- elif page.type === 'tags' and not page.title %}
    {{- __('title.tag') + page_title_suffix }}
  {%- elif page.type === 'schedule' and not page.title %}
    {{- __('title.schedule') + page_title_suffix }}
  {%- else %}
    {{- page.title + page_title_suffix }}
  {%- endif %}
{% endblock %}

{% block class %}page posts-expand{% if page.type === 'category-landing' %} category-landing-layout{% endif %}{% endblock %}

{% block content %}

  {# 分类介绍页：左侧文章列表栏（与文章详情页共用） #}
  {% if page.type === 'category-landing' %}
    {% set catData = get_category_landing(page.category_name) %}
    {% if catData %}
    <aside class="post-cat-sidebar">
      <div class="category-landing-sidebar-header">
        <i class="fa {{ catData.icon }}"></i>
        <span>{{ catData.name }}</span>
        <span class="category-landing-post-count">{{ catData.allPosts.length }}</span>
      </div>
      <nav class="category-landing-nav">
        {% for child in catData.children %}
        {% if child.hasSubGroups %}
          <details class="category-landing-sub">
            <summary class="category-landing-sub-title">
              <i class="fa fa-folder"></i> {{ child.name }}
              <span class="category-landing-sub-count">{{ child.totalPosts }}</span>
              <i class="fa fa-chevron-down category-landing-chevron"></i>
            </summary>
            {% if child.directPosts.length > 0 %}
            <ul class="category-landing-post-list">
              {% for post in child.directPosts %}
              <li>
                <a href="{{ url_for(post.path) }}">
                  <span>{{ post.title }}</span>
                </a>
              </li>
              {% endfor %}
            </ul>
            {% endif %}
            {% for sg in child.subGroups %}
            <details class="category-landing-sub-l3">
              <summary class="category-landing-sub-title-l3">
                <i class="fa fa-folder-o"></i> {{ sg.name }}
                <span class="category-landing-sub-count">{{ sg.posts.length }}</span>
                <i class="fa fa-chevron-down category-landing-chevron"></i>
              </summary>
              <ul class="category-landing-post-list category-landing-post-list-l3">
                {% for post in sg.posts %}
                <li>
                  <a href="{{ url_for(post.path) }}">
                    <span>{{ post.title }}</span>
                  </a>
                </li>
                {% endfor %}
              </ul>
            </details>
            {% endfor %}
          </details>
        {% else %}
          <details class="category-landing-sub">
            <summary class="category-landing-sub-title">
              <i class="fa fa-folder"></i> {{ child.name }}
              <span class="category-landing-sub-count">{{ child.posts.length }}</span>
              <i class="fa fa-chevron-down category-landing-chevron"></i>
            </summary>
            <ul class="category-landing-post-list">
              {% for post in child.posts %}
              <li>
                <a href="{{ url_for(post.path) }}">
                  <span>{{ post.title }}</span>
                </a>
              </li>
              {% endfor %}
            </ul>
          </details>
        {% endif %}
        {% endfor %}
      </nav>
    </aside>
    {% endif %}
  {% endif %}

    {##################}
    {### PAGE BLOCK ###}
    {##################}
    <div class="post-block" lang="{{ page.lang }}">
      {%- if page.header !== false %}
        {%- include '_partials/page/page-header.njk' -%}
      {%- endif %}
      {#################}
      {### PAGE BODY ###}
      {#################}
      <div class="post-body{% if page.direction and page.direction.toLowerCase() === 'rtl' %} rtl{% endif %}">
        {%- if page.type === 'tags' %}
          {%- include '_partials/page/tags.njk' -%}
        {% elif page.type === 'categories' %}
          {%- include '_partials/page/categories.njk' -%}
        {% elif page.type === 'schedule' %}
          {%- include '_partials/page/schedule.njk' -%}
        {% elif page.type === 'category-landing' %}
          {% if catData %}
          <div class="category-landing-page">
            <div class="category-landing-hero">
              <div class="category-landing-hero-icon">
                <i class="fa {{ catData.icon }}"></i>
              </div>
              <h1 class="category-landing-title">{{ catData.name }}</h1>
              <p class="category-landing-desc">{{ catData.description }}</p>
              <div class="category-landing-stats">
                <span class="category-landing-stat">
                  <i class="fa fa-folder-open"></i> {{ catData.children.length }} 个子分类
                </span>
                <span class="category-landing-stat">
                  <i class="fa fa-file-text"></i> {{ catData.allPosts.length }} 篇文章
                </span>
              </div>
            </div>

            <div class="category-landing-sections">
              {% for child in catData.children %}
              <div class="category-landing-section">
                <div class="category-landing-section-header">
                  <i class="fa fa-folder"></i>
                  <span>{{ child.name }}</span>
                  <span class="category-landing-section-count">{{ child.totalPosts }} 篇</span>
                </div>
                {% if child.hasSubGroups %}
                  {% if child.directPosts.length > 0 %}
                  <ul class="category-landing-section-list">
                    {% for post in child.directPosts %}
                    <li>
                      <a href="{{ url_for(post.path) }}">
                        <span class="category-landing-article-title">{{ post.title }}</span>
                      </a>
                    </li>
                    {% endfor %}
                  </ul>
                  {% endif %}
                  {% for sg in child.subGroups %}
                  <div class="category-landing-sub-section">
                    <div class="category-landing-sub-section-header">
                      <i>✈️</i>
                      <span>{{ sg.name }}</span>
                      <span class="category-landing-section-count">{{ sg.posts.length }} 篇</span>
                    </div>
                    <ul class="category-landing-section-list">
                      {% for post in sg.posts %}
                      <li>
                        <a href="{{ url_for(post.path) }}">
                          <span class="category-landing-article-title">{{ post.title }}</span>
                        </a>
                      </li>
                      {% endfor %}
                    </ul>
                  </div>
                  {% endfor %}
                {% else %}
                <ul class="category-landing-section-list">
                  {% for post in child.posts %}
                  <li>
                    <a href="{{ url_for(post.path) }}">
                      <span class="category-landing-article-title">{{ post.title }}</span>
                    </a>
                  </li>
                  {% endfor %}
                </ul>
                {% endif %}
              </div>
              {% endfor %}
            </div>
          </div>
          {% endif %}
        {% else %}
          {{ page.content }}
        {%- endif %}
      </div>
      {#####################}
      {### END PAGE BODY ###}
      {#####################}
    </div>
    {%- include '_partials/page/breadcrumb.njk' -%}
    {######################}
    {### END PAGE BLOCK ###}
    {######################}

{% endblock %}

{% block sidebar %}
  {{ sidebar_template.render(page.toc.enable) }}
{% endblock %}
