{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}{{ page.title }} | {{ title }}{% endblock %}

{% block class %}post posts-expand{% endblock %}

{% block content %}

  {% set catSidebar = get_post_category_sidebar(page) %}
  {% if catSidebar %}
  <aside class="post-cat-sidebar">
    <div class="category-landing-sidebar-header">
      <a href="{{ catSidebar.landingPath }}" style="color:inherit;text-decoration:none;border:none;display:flex;align-items:center;gap:10px;flex:1">
        <i class="fa {{ catSidebar.icon }}"></i>
        <span>{{ catSidebar.name }}</span>
      </a>
      <span class="category-landing-post-count">{{ catSidebar.totalPosts }}</span>
    </div>
    <nav class="category-landing-nav">
      {% for child in catSidebar.children %}
      {% if child.hasSubGroups %}
        {# 有三级子分类的二级分类 #}
        {% set hasAnyCurrent = false %}
        {% for post in child.directPosts %}
          {% if post._id === page._id %}{% set hasAnyCurrent = true %}{% endif %}
        {% endfor %}
        {% for sg in child.subGroups %}
          {% for post in sg.posts %}
            {% if post._id === page._id %}{% set hasAnyCurrent = true %}{% endif %}
          {% endfor %}
        {% endfor %}
        <details class="category-landing-sub"{% if hasAnyCurrent %} open{% endif %}>
          <summary class="category-landing-sub-title">
            <i class="fa fa-folder"></i> {{ child.name }}
            <span class="category-landing-sub-count">{{ child.totalPosts }}</span>
            <i class="fa fa-chevron-down category-landing-chevron"></i>
          </summary>
          {% if child.directPosts.length > 0 %}
          <ul class="category-landing-post-list">
            {% for post in child.directPosts %}
            <li{% if post._id === page._id %} class="current-post"{% endif %}>
              <a href="{{ url_for(post.path) }}">
                <span>{{ post.title }}</span>
              </a>
            </li>
            {% endfor %}
          </ul>
          {% endif %}
          {% for sg in child.subGroups %}
            {% set sgHasCurrent = false %}
            {% for post in sg.posts %}
              {% if post._id === page._id %}{% set sgHasCurrent = true %}{% endif %}
            {% endfor %}
            <details class="category-landing-sub-l3"{% if sgHasCurrent %} open{% endif %}>
              <summary class="category-landing-sub-title-l3">
                <i class="fa fa-folder-o"></i> {{ sg.name }}
                <span class="category-landing-sub-count">{{ sg.posts.length }}</span>
                <i class="fa fa-chevron-down category-landing-chevron"></i>
              </summary>
              <ul class="category-landing-post-list category-landing-post-list-l3">
                {% for post in sg.posts %}
                <li{% if post._id === page._id %} class="current-post"{% endif %}>
                  <a href="{{ url_for(post.path) }}">
                    <span>{{ post.title }}</span>
                  </a>
                </li>
                {% endfor %}
              </ul>
            </details>
          {% endfor %}
        </details>
      {% else %}
        {# 无三级子分类：保持原样 #}
        {% set hasCurrent = false %}
        {% for post in child.posts %}
          {% if post._id === page._id %}{% set hasCurrent = true %}{% endif %}
        {% endfor %}
        <details class="category-landing-sub"{% if hasCurrent %} open{% endif %}>
          <summary class="category-landing-sub-title">
            <i class="fa fa-folder"></i> {{ child.name }}
            <span class="category-landing-sub-count">{{ child.posts.length }}</span>
            <i class="fa fa-chevron-down category-landing-chevron"></i>
          </summary>
          <ul class="category-landing-post-list">
            {% for post in child.posts %}
            <li{% if post._id === page._id %} class="current-post"{% endif %}>
              <a href="{{ url_for(post.path) }}">
                <span>{{ post.title }}</span>
              </a>
            </li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}
      {% endfor %}
    </nav>
  </aside>
  {% endif %}

  {{ partial('_macro/post.njk', {post: page}) }}

{% endblock %}

{% block sidebar %}
  {{ sidebar_template.render(page.toc.enable) }}
{% endblock %}
